<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<%- include('partials/head', { pageTitle: pageTitle }) %>
<body class="bg-dark-bg text-zinc-100 font-sans antialiased selection:bg-blue-600 selection:text-white relative overflow-x-hidden min-h-screen">

    <!-- Subtle Deep Atmosphere Light with Slight Blue Tint -->
    <div class="fixed inset-0 grid-bg bg-grid-pattern opacity-30 pointer-events-none"></div>
    <div class="fixed top-[-15%] left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-blue-950/20 via-zinc-900/10 to-transparent blur-[160px] rounded-full pointer-events-none"></div>

    <%- include('partials/header') %>

    <!-- Hero Section -->
    <section class="pt-36 pb-24 px-6 relative z-10">
        <div class="max-w-5xl mx-auto text-center">
            
            <!-- Subtle Blue Badge -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono glass-panel border border-blue-500/20 text-zinc-300 mb-8 hover:border-blue-500/40 transition-colors">
                <span class="flex h-1.5 w-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                <span>Flogs Engine v2.0 Live</span>
                <span class="text-zinc-600">•</span>
                <span class="text-zinc-400">Zero-Config Campaign Tracking</span>
            </div>
            
            <!-- Animated Hero Title with Subtle Blue Gradient -->
            <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-[1.1] text-white mb-6">
                Generate Campaigns. <br/>
                <span class="relative inline-block mt-2">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-blue-400 animate-gradient-x text-glow">
                        Ship Faster.
                    </span>
                    <!-- Speed Trail Accent Line with Blue Hint -->
                    <span class="absolute -bottom-2 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-blue-500/60 to-transparent overflow-hidden rounded-full">
                        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white to-transparent animate-fast-trail"></span>
                    </span>
                </span>
            </h1>
            
            <p class="text-lg md:text-xl text-zinc-400 mb-12 max-w-2xl mx-auto font-normal leading-relaxed">
                The stealth campaign link generator built for speed-focused growth teams. Ditch spreadsheets, standardize tracking, and ship links in seconds.
            </p>

            <!-- Interactive Link Builder -->
            <div id="builder" class="max-w-3xl mx-auto glass-panel rounded-3xl p-2 md:p-3 shadow-2xl relative glow-effect">
                <div class="bg-dark-card/90 rounded-2xl p-6 md:p-8 text-left border border-dark-border">
                    <div class="flex items-center justify-between pb-6 mb-6 border-b border-dark-border">
                        <div class="flex items-center space-x-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-zinc-800 inline-block border border-zinc-700"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-zinc-800 inline-block border border-zinc-700"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-zinc-800 inline-block border border-zinc-700"></span>
                        </div>
                        <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Campaign Studio</span>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-mono text-zinc-400 mb-1.5">DESTINATION_URL</label>
                            <input type="url" placeholder="https://yourbrand.com/launch" class="w-full bg-dark-bg border border-dark-border focus:border-blue-500/60 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 outline-none transition-all font-mono">
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-mono text-zinc-400 mb-1.5">CAMPAIGN</label>
                                <input type="text" placeholder="q3_launch" class="w-full bg-dark-bg border border-dark-border focus:border-blue-500/60 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 outline-none transition-all font-mono">
                            </div>
                            <div>
                                <label class="block text-xs font-mono text-zinc-400 mb-1.5">SOURCE</label>
                                <input type="text" placeholder="twitter" class="w-full bg-dark-bg border border-dark-border focus:border-blue-500/60 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 outline-none transition-all font-mono">
                            </div>
                            <div>
                                <label class="block text-xs font-mono text-zinc-400 mb-1.5">MEDIUM</label>
                                <input type="text" placeholder="paid_social" class="w-full bg-dark-bg border border-dark-border focus:border-blue-500/60 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 outline-none transition-all font-mono">
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 pt-4">
                        <a href="/login" class="w-full group relative inline-flex items-center justify-center p-0.5 overflow-hidden text-sm font-semibold rounded-xl text-zinc-950 shadow-xl transition-all duration-300 active:scale-[0.99]">
                            <span class="w-full py-4 px-6 rounded-[10px] flex items-center justify-center space-x-2 bg-white group-hover:bg-zinc-100 transition-all duration-300 font-bold">
                                <span>Generate Campaign & Ship</span>
                                <svg class="w-4 h-4 text-blue-600 group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Social Proof -->
    <section class="py-10 border-y border-dark-border bg-dark-card/50">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <p class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-8">Powering link architectures for modern brands</p>
            <div class="flex flex-wrap items-center justify-center gap-10 md:gap-16 opacity-30 grayscale text-white font-mono font-bold tracking-widest text-sm">
                <span>// ACME_CORP</span>
                <span>// VORTEX</span>
                <span>// HYPERLUME</span>
                <span>// VECTOR_HQ</span>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-24 px-6 relative z-10">
        <div class="max-w-6xl mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <h2 class="text-3xl md:text-4xl font-black text-white mb-4">Engineered for Stealth & Speed</h2>
                <p class="text-zinc-400">Everything needed to structure, standardize, and launch tracking links with maximum velocity.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-panel p-8 rounded-2xl hover:border-blue-500/30 transition-all duration-300 group">
                    <div class="w-12 h-12 rounded-xl bg-zinc-900/90 border border-zinc-800 flex items-center justify-center text-blue-400 mb-6 group-hover:border-blue-500/40 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Instant Generation</h3>
                    <p class="text-sm text-zinc-400 leading-relaxed">Auto-clean parameters, remove illegal characters, and build production-ready links in milliseconds.</p>
                </div>

                <div class="glass-panel p-8 rounded-2xl hover:border-blue-500/30 transition-all duration-300 group">
                    <div class="w-12 h-12 rounded-xl bg-zinc-900/90 border border-zinc-800 flex items-center justify-center text-blue-400 mb-6 group-hover:border-blue-500/40 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Naming Guardrails</h3>
                    <p class="text-sm text-zinc-400 leading-relaxed">Enforce lowercase casing, hyphenation, and preset parameters across your entire marketing team.</p>
                </div>

                <div class="glass-panel p-8 rounded-2xl hover:border-blue-500/30 transition-all duration-300 group">
                    <div class="w-12 h-12 rounded-xl bg-zinc-900/90 border border-zinc-800 flex items-center justify-center text-blue-400 mb-6 group-hover:border-blue-500/40 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">API & Webhooks</h3>
                    <p class="text-sm text-zinc-400 leading-relaxed">Programmatically generate links straight from your CI/CD pipelines, CMS, or internal automation scripts.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-24 px-6 border-t border-dark-border bg-dark-card/30 relative z-10">
        <div class="max-w-3xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-black text-white mb-4">Frequently Asked Questions</h2>
                <p class="text-zinc-400">Everything you need to know about setting up and scaling with Flogs.</p>
            </div>

            <div class="space-y-4" x-data="{ openFaq: null }">
                
                <!-- FAQ Item 1 -->
                <div class="glass-panel rounded-2xl border border-dark-border overflow-hidden transition-colors hover:border-blue-500/20">
                    <button @click="openFaq = (openFaq === 1 ? null : 1)" class="w-full text-left p-6 flex items-center justify-between text-white font-semibold focus:outline-none">
                        <span>How does Flogs enforce naming standards across teams?</span>
                        <svg class="w-5 h-5 text-blue-400 transition-transform duration-300" :class="{ 'rotate-180': openFaq === 1 }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div x-show="openFaq === 1" x-collapse class="px-6 pb-6 text-sm text-zinc-400 leading-relaxed">
                        Flogs lets workspace admins define strict preset rules—such as forcing lowercase characters, auto-converting spaces to hyphens, and restricting campaign sources to pre-approved dropdown options.
                    </div>
                </div>

                <!-- FAQ Item 2 -->
                <div class="glass-panel rounded-2xl border border-dark-border overflow-hidden transition-colors hover:border-blue-500/20">
                    <button @click="openFaq = (openFaq === 2 ? null : 2)" class="w-full text-left p-6 flex items-center justify-between text-white font-semibold focus:outline-none">
                        <span>Can I connect custom domains for shortened links?</span>
                        <svg class="w-5 h-5 text-blue-400 transition-transform duration-300" :class="{ 'rotate-180': openFaq === 2 }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div x-show="openFaq === 2" x-collapse class="px-6 pb-6 text-sm text-zinc-400 leading-relaxed">
                        Yes. You can attach unlimited custom branded domains via DNS CNAME records, ensuring every short link aligns with your brand identity.
                    </div>
                </div>

                <!-- FAQ Item 3 -->
                <div class="glass-panel rounded-2xl border border-dark-border overflow-hidden transition-colors hover:border-blue-500/20">
                    <button @click="openFaq = (openFaq === 3 ? null : 3)" class="w-full text-left p-6 flex items-center justify-between text-white font-semibold focus:outline-none">
                        <span>Is there an API to automate campaign link creation?</span>
                        <svg class="w-5 h-5 text-blue-400 transition-transform duration-300" :class="{ 'rotate-180': openFaq === 3 }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div x-show="openFaq === 3" x-collapse class="px-6 pb-6 text-sm text-zinc-400 leading-relaxed">
                        Absolutely. Flogs provides a high-performance REST API and Zapier integrations to automatically generate UTM links directly from your marketing workflows or CRM.
                    </div>
                </div>

                <!-- FAQ Item 4 -->
                <div class="glass-panel rounded-2xl border border-dark-border overflow-hidden transition-colors hover:border-blue-500/20">
                    <button @click="openFaq = (openFaq === 4 ? null : 4)" class="w-full text-left p-6 flex items-center justify-between text-white font-semibold focus:outline-none">
                        <span>How does Flogs handle link privacy and telemetry?</span>
                        <svg class="w-5 h-5 text-blue-400 transition-transform duration-300" :class="{ 'rotate-180': openFaq === 4 }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div x-show="openFaq === 4" x-collapse class="px-6 pb-6 text-sm text-zinc-400 leading-relaxed">
                        We prioritize privacy with cookie-less click tracking. Analytics provide real-time counts, geographic breakdown, and attribution without storing personally identifiable information (PII).
                    </div>
                </div>

            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

</body>
</html>
