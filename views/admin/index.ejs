<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Flogs — Admin Dashboard' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: linear-gradient(135deg, #f0f4f8 0%, #e8f0f7 100%); }
    .nav-item { @apply rounded-lg border border-blue-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-gray-700 transition hover:bg-blue-50 hover:border-blue-300; }
    .nav-item.active { @apply border-blue-500 bg-blue-50 text-blue-600 font-semibold; }
    .stat-card { @apply rounded-2xl border border-blue-100 bg-white p-6 shadow-sm; }
    .btn-primary { @apply rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 active:bg-blue-800; }
    .mobile-nav { @apply fixed inset-y-0 left-0 z-50 w-64 bg-white shadow-lg transform transition-transform duration-300 ease-in-out; }
    .mobile-nav.hidden { @apply -translate-x-full; }
    .mobile-nav.show { @apply translate-x-0; }
    .mobile-overlay { @apply fixed inset-0 z-40 bg-black/50 transition-opacity duration-300; }
  </style>
</head>
<body class="min-h-screen font-sans antialiased">
  <div id="mobileOverlay" class="mobile-overlay hidden" onclick="toggleMobileNav()"></div>
  
  <nav id="mobileNav" class="mobile-nav hidden">
    <div class="flex items-center justify-between border-b border-gray-200 p-4">
      <h2 class="text-lg font-bold text-gray-900">Menu</h2>
      <button onclick="toggleMobileNav()" class="rounded-lg p-2 hover:bg-gray-100">
        <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="space-y-2 p-4">
      <a href="/admin" class="block rounded-lg border border-blue-500 bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-600">
        Overview
      </a>
      <a href="/admin/credit" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Credit
      </a>
      <a href="/admin/generation-requests" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Generation
      </a>
      <a href="/admin/settings" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Settings
      </a>
      <form action="/logout" method="post" class="pt-4 border-t border-gray-200">
        <button type="submit" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
          Logout
        </button>
      </form>
    </div>
  </nav>

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div class="flex items-center gap-4">
        <button onclick="toggleMobileNav()" class="rounded-lg p-2 hover:bg-gray-200 sm:hidden">
          <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-blue-600">Admin Panel</p>
          <h1 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">Dashboard</h1>
        </div>
      </div>
      <form action="/logout" method="post">
        <button type="submit" class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50 hover:border-gray-400">
          Logout
        </button>
      </form>
    </header>

    <nav class="mb-8 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
      <a href="/admin" class="nav-item <%= activeNav === 'overview' ? 'active' : '' %>">Overview</a>
      <a href="/admin/credit" class="nav-item <%= activeNav === 'credit' ? 'active' : '' %>">Credit</a>
      <a href="/admin/generation-requests" class="nav-item <%= activeNav === 'generation' ? 'active' : '' %>">Generation</a>
      <a href="/admin/settings" class="nav-item <%= activeNav === 'settings' ? 'active' : '' %>">Settings</a>
    </nav>

    <section class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="stat-card">
        <p class="text-xs font-bold uppercase tracking-widest text-blue-600">Total Users</p>
        <p class="mt-4 text-4xl font-bold text-gray-900"><%= users.length %></p>
        <p class="mt-2 text-sm text-gray-500">Registered accounts</p>
      </div>
      <div class="stat-card">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-600">Pending Requests</p>
        <p class="mt-4 text-4xl font-bold text-gray-900"><%= users.reduce((sum, user) => sum + (Array.isArray(user.linkHistory) ? user.linkHistory.filter((item) => (item.status || 'pending_generation') === 'pending_generation').length : 0), 0) %></p>
        <p class="mt-2 text-sm text-gray-500">Awaiting response</p>
      </div>
      <div class="stat-card">
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-600">Generated Links</p>
        <p class="mt-4 text-4xl font-bold text-gray-900"><%= users.reduce((sum, user) => sum + (Array.isArray(user.linkHistory) ? user.linkHistory.filter((item) => item.generatedUrl).length : 0), 0) %></p>
        <p class="mt-2 text-sm text-gray-500">Completed</p>
      </div>
    </section>

    <section class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold text-gray-900">Recent Users</h2>
      <p class="mt-1 text-sm text-gray-500">Latest accounts joined</p>
      <div class="mt-6 space-y-3 overflow-x-auto">
        <% users.slice(0, 6).forEach((person) => { %>
          <div class="flex flex-col items-start justify-between gap-3 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 sm:flex-row sm:items-center">
            <div class="flex-1">
              <p class="font-semibold text-gray-900"><%= person.name %></p>
              <p class="text-sm text-gray-500"><%= person.email %></p>
            </div>
            <div class="text-right">
              <p class="text-xs font-medium uppercase tracking-widest text-gray-600">Requests</p>
              <p class="text-lg font-bold text-blue-600"><%= Array.isArray(person.linkHistory) ? person.linkHistory.length : 0 %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  </div>

  <script>
    function toggleMobileNav() {
      const nav = document.getElementById('mobileNav');
      const overlay = document.getElementById('mobileOverlay');
      nav.classList.toggle('hidden');
      nav.classList.toggle('show');
      overlay.classList.toggle('hidden');
    }
  </script>
</body>
</html>
