<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Flogs — Generation Requests' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: linear-gradient(135deg, #f0f4f8 0%, #e8f0f7 100%); }
    .nav-item { @apply rounded-lg border border-blue-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-gray-700 transition hover:bg-blue-50 hover:border-blue-300; }
    .nav-item.active { @apply border-blue-500 bg-blue-50 text-blue-600 font-semibold; }
    .btn-primary { @apply rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 active:bg-blue-800; }
    input { @apply rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100; }
    .mobile-nav { @apply fixed inset-y-0 left-0 z-50 w-64 bg-white shadow-lg transform transition-transform duration-300 ease-in-out; }
    .mobile-nav.hidden { @apply -translate-x-full; }
    .mobile-nav.show { @apply translate-x-0; }
    .mobile-overlay { @apply fixed inset-0 z-40 bg-black/50 transition-opacity duration-300; }
  </style>
</head>
<body class="min-h-screen font-sans antialiased">
  <div id="mobileOverlay" class="mobile-overlay hidden" onclick="toggleMobileNav()"></div>
  
  <nav id="mobileNav" class="mobile-nav hidden">
    <div class="flex items-center justify-between border-b border-gray-200 p-4">
      <h2 class="text-lg font-bold text-gray-900">Menu</h2>
      <button onclick="toggleMobileNav()" class="rounded-lg p-2 hover:bg-gray-100">
        <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="space-y-2 p-4">
      <a href="/admin" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Overview
      </a>
      <a href="/admin/credit" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Credit
      </a>
      <a href="/admin/generation-requests" class="block rounded-lg border border-blue-500 bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-600">
        Generation
      </a>
      <a href="/admin/settings" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Settings
      </a>
      <form action="/logout" method="post" class="pt-4 border-t border-gray-200">
        <button type="submit" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
          Logout
        </button>
      </form>
    </div>
  </nav>

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div class="flex items-center gap-4">
        <button onclick="toggleMobileNav()" class="rounded-lg p-2 hover:bg-gray-200 sm:hidden">
          <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-blue-600">Admin</p>
          <h1 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">Generation Requests</h1>
        </div>
      </div>
      <form action="/logout" method="post">
        <button type="submit" class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
          Logout
        </button>
      </form>
    </header>

    <nav class="mb-8 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
      <a href="/admin" class="nav-item">Overview</a>
      <a href="/admin/credit" class="nav-item">Credit</a>
      <a href="/admin/generation-requests" class="nav-item active">Generation</a>
      <a href="/admin/settings" class="nav-item">Settings</a>
    </nav>

    <section class="space-y-4">
      <% if (requests && requests.length) { %>
        <% requests.forEach((requestItem) => { %>
          <div class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="mb-4 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-start">
              <div class="flex-1">
                <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-3">
                  <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-gray-500"><%= requestItem.userName %></p>
                    <p class="text-sm text-gray-600"><%= requestItem.userEmail %></p>
                  </div>
                  <span class="inline-block rounded-lg bg-blue-100 px-2.5 py-1 text-xs font-bold uppercase text-blue-700"><%= requestItem.platform %></span>
                </div>
                <h2 class="mt-3 text-2xl font-bold text-gray-900"><%= requestItem.title %></h2>
                <div class="mt-3 flex flex-wrap gap-4 text-sm text-gray-600">
                  <span><strong>Duration:</strong> <%= requestItem.duration %></span>
                  <span><strong>Tokens:</strong> <%= requestItem.tokens %></span>
                </div>
                <p class="mt-2 text-xs text-gray-500">Requested: <%= new Date(requestItem.createdAt).toLocaleString() %></p>
              </div>
              <div class="shrink-0">
                <% if (requestItem.status === 'generated') { %>
                  <span class="inline-block rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-bold uppercase text-emerald-700">Generated</span>
                <% } else { %>
                  <span class="inline-block rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-sm font-bold uppercase text-amber-700">Pending</span>
                <% } %>
              </div>
            </div>

            <form action="/admin/generation-requests/<%= requestItem.userId %>/<%= requestItem.requestId %>" method="post" class="space-y-4 border-t border-gray-200 pt-6">
              <div>
                <label class="mb-2 block text-sm font-semibold text-gray-900">Public URL</label>
                <input name="generatedUrl" type="url" value="<%= requestItem.generatedUrl || '' %>" placeholder="https://example.com/campaign" class="w-full" />
              </div>
              <button type="submit" class="btn-primary w-full sm:w-auto">Respond with URL</button>
            </form>
          </div>
        <% }) %>
      <% } else { %>
        <div class="rounded-2xl border border-blue-100 bg-white p-12 text-center shadow-sm">
          <h2 class="text-2xl font-bold text-gray-900">No Requests Yet</h2>
          <p class="mt-2 text-gray-600">New user generation requests will appear here.</p>
        </div>
      <% } %>
    </section>
  </div>

  <script>
    function toggleMobileNav() {
      const nav = document.getElementById('mobileNav');
      const overlay = document.getElementById('mobileOverlay');
      nav.classList.toggle('hidden');
      nav.classList.toggle('show');
      overlay.classList.toggle('hidden');
    }
  </script>
</body>
</html>
