<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Flogs — Admin Credit' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: linear-gradient(135deg, #f0f4f8 0%, #e8f0f7 100%); }
    .nav-item { @apply rounded-lg border border-blue-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-gray-700 transition hover:bg-blue-50 hover:border-blue-300; }
    .nav-item.active { @apply border-blue-500 bg-blue-50 text-blue-600 font-semibold; }
    .btn-primary { @apply rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 active:bg-blue-800; }
    input, select { @apply rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100; }
    .mobile-nav { @apply fixed inset-y-0 left-0 z-50 w-64 bg-white shadow-lg transform transition-transform duration-300 ease-in-out; }
    .mobile-nav.hidden { @apply -translate-x-full; }
    .mobile-nav.show { @apply translate-x-0; }
    .mobile-overlay { @apply fixed inset-0 z-40 bg-black/50 transition-opacity duration-300; }
  </style>
</head>
<body class="min-h-screen font-sans antialiased">
  <div id="mobileOverlay" class="mobile-overlay hidden" onclick="toggleMobileNav()"></div>
  
  <nav id="mobileNav" class="mobile-nav hidden">
    <div class="flex items-center justify-between border-b border-gray-200 p-4">
      <h2 class="text-lg font-bold text-gray-900">Menu</h2>
      <button onclick="toggleMobileNav()" class="rounded-lg p-2 hover:bg-gray-100">
        <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="space-y-2 p-4">
      <a href="/admin" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Overview
      </a>
      <a href="/admin/credit" class="block rounded-lg border border-blue-500 bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-600">
        Credit
      </a>
      <a href="/admin/generation-requests" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Generation
      </a>
      <a href="/admin/settings" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Settings
      </a>
      <form action="/logout" method="post" class="pt-4 border-t border-gray-200">
        <button type="submit" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
          Logout
        </button>
      </form>
    </div>
  </nav>

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div class="flex items-center gap-4">
        <button onclick="toggleMobileNav()" class="rounded-lg p-2 hover:bg-gray-200 sm:hidden">
          <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-blue-600">Admin</p>
          <h1 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">Credit Management</h1>
        </div>
      </div>
      <form action="/logout" method="post">
        <button type="submit" class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
          Logout
        </button>
      </form>
    </header>

    <nav class="mb-8 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
      <a href="/admin" class="nav-item">Overview</a>
      <a href="/admin/credit" class="nav-item active">Credit</a>
      <a href="/admin/generation-requests" class="nav-item">Generation</a>
      <a href="/admin/settings" class="nav-item">Settings</a>
    </nav>

    <div class="grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-1 rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-gray-900">Credit Tokens</h2>
        <p class="mt-2 text-sm text-gray-600">Select a user and credit them tokens.</p>

        <% if (message) { %>
          <div class="mt-4 rounded-lg border <%= message.type === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-red-200 bg-red-50 text-red-700' %> px-4 py-3 text-sm font-medium">
            <%= message.text %>
          </div>
        <% } %>

        <form action="/admin/credit" method="post" class="mt-6 space-y-4">
          <div>
            <label for="userId" class="mb-2 block text-sm font-semibold text-gray-900">Select User</label>
            <select id="userId" name="userId" class="w-full" required>
              <option value="">Choose a user...</option>
              <% users.forEach((user) => { %>
                <option value="<%= user._id %>"><%= user.name %> — <%= user.email %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="amount" class="mb-2 block text-sm font-semibold text-gray-900">Token Amount</label>
            <input id="amount" name="amount" type="number" min="1" step="1" placeholder="10" required />
          </div>

          <button type="submit" class="btn-primary w-full">Credit Tokens</button>
        </form>
      </div>

      <div class="lg:col-span-2 rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-gray-900">User Balances</h2>
        <p class="mt-2 text-sm text-gray-600">Current token balance for each user</p>
        <div class="mt-6 space-y-2 max-h-96 overflow-y-auto">
          <% if (users && users.length) { %>
            <% users.forEach((user) => { %>
              <div class="flex flex-col items-start justify-between gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 sm:flex-row sm:items-center">
                <div class="flex-1">
                  <p class="font-semibold text-gray-900"><%= user.name %></p>
                  <p class="text-sm text-gray-500"><%= user.email %></p>
                </div>
                <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm font-bold text-blue-600">
                  <%= Number(user.credits?.balance || 0) %> tokens
                </span>
              </div>
            <% }) %>
          <% } else { %>
            <p class="py-8 text-center text-gray-500">No users found.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleMobileNav() {
      const nav = document.getElementById('mobileNav');
      const overlay = document.getElementById('mobileOverlay');
      nav.classList.toggle('hidden');
      nav.classList.toggle('show');
      overlay.classList.toggle('hidden');
    }
  </script>
</body>
</html>
