<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
	<title><%= pageTitle || 'Flogs - Transactions' %></title>
	<script src="https://cdn.tailwindcss.com"></script>
	<style>
		body {
			background-color: #050505;
			color: #e4e4e7;
		}
		.dark-card,
		.filter-container {
			background-color: #0d0d0d;
			border: 1px solid #1c1c21;
		}
		.tab-btn {
			transition: all 0.2s ease;
		}
		.tab-active {
			background-color: #27272a;
			color: #ffffff;
			font-weight: 500;
		}
		.tab-inactive {
			color: #a1a1aa;
		}
		.tab-inactive:hover {
			color: #ffffff;
		}
		.glass-nav {
			background: rgba(13, 13, 13, 0.85);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border-top: 1px solid rgba(255, 255, 255, 0.08);
			padding-bottom: env(safe-area-inset-bottom, 8px);
		}
	</style>
</head>
<body class="min-h-screen bg-black text-gray-200 font-sans antialiased pb-28">
	<%- include('../partials/header') %>

	<main class="max-w-xl mx-auto px-4 py-6 space-y-6">
		<div class="space-y-4">
			<button type="button" onclick="window.history.back()" class="inline-flex items-center gap-2 text-zinc-400 hover:text-white text-sm font-medium transition">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
				</svg>
				Back to Dashboard
			</button>

			<div class="space-y-1">
				<div class="flex items-center gap-2.5">
					<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
					</svg>
					<h1 class="text-3xl font-bold tracking-tight text-white">My Transactions</h1>
				</div>
				<p class="text-sm text-zinc-400 pt-1">
					Payment history and free token claims. Current price: <span class="text-zinc-200 font-medium">₦5,100 / token</span>.
				</p>
			</div>
		</div>

		<div class="filter-container p-1 rounded-2xl inline-flex items-center gap-1">
			<button type="button" onclick="setFilter('all')" id="tab-all" class="tab-btn tab-active px-4 py-1.5 rounded-xl text-sm">All</button>
			<button type="button" onclick="setFilter('pending')" id="tab-pending" class="tab-btn tab-inactive px-4 py-1.5 rounded-xl text-sm">Pending</button>
			<button type="button" onclick="setFilter('completed')" id="tab-completed" class="tab-btn tab-inactive px-4 py-1.5 rounded-xl text-sm">Completed</button>
			<button type="button" onclick="setFilter('failed')" id="tab-failed" class="tab-btn tab-inactive px-4 py-1.5 rounded-xl text-sm">Failed</button>
		</div>

		<section id="transactionSection" class="space-y-3">
			<% if (transactions && transactions.length) { %>
				<% transactions.forEach((transaction) => { %>
					<div class="transaction-item dark-card rounded-2xl p-4" data-status="<%= transaction.status === 'paid' ? 'completed' : transaction.status %>">
						<div class="flex items-start justify-between gap-3">
							<div>
								<p class="text-sm font-semibold text-white">Credit top-up</p>
								<p class="mt-1 text-xs text-zinc-400"><%= new Date(transaction.paidAt).toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
							</div>
							<span class="rounded-full border px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.12em] <%= transaction.status === 'paid' ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300' : 'border-amber-500/40 bg-amber-500/10 text-amber-300' %>">
								<%= transaction.status === 'paid' ? 'Completed' : transaction.status %>
							</span>
						</div>
						<div class="mt-4 flex items-center justify-between">
							<p class="text-xl font-bold text-white">₦<%= Number(transaction.amountNaira).toLocaleString('en-NG') %></p>
							<p class="text-sm text-zinc-400"><%= Number(transaction.tokenAmount) %> tokens</p>
						</div>
						<p class="mt-3 text-[11px] text-zinc-500">Reference: <%= transaction.reference %></p>
					</div>
				<% }) %>
			<% } else { %>
				<div id="emptyState" class="dark-card rounded-2xl p-12 min-h-[220px] flex flex-col items-center justify-center text-center space-y-3">
					<p id="emptyStateText" class="text-zinc-400 text-sm font-medium">No transactions yet.</p>
					<a href="/dashboard/credit" class="text-sm text-white underline underline-offset-4 decoration-zinc-500 hover:decoration-white transition">Buy credits from the dashboard</a>
				</div>
			<% } %>
		</section>
	</main>

	<%- include('../partials/nav', { activeNav: 'transactions' }) %>

	<script>
		function setFilter(status) {
			const tabs = ['all', 'pending', 'completed', 'failed'];
			tabs.forEach(tab => {
				const button = document.getElementById(`tab-${tab}`);
				if (button) {
					button.className = tab === status
						? 'tab-btn tab-active px-4 py-1.5 rounded-xl text-sm'
						: 'tab-btn tab-inactive px-4 py-1.5 rounded-xl text-sm';
				}
			});

			const items = document.querySelectorAll('.transaction-item');
			let visibleCount = 0;

			items.forEach((item) => {
				const matches = status === 'all' || item.dataset.status === status;
				item.style.display = matches ? 'block' : 'none';
				if (matches) visibleCount += 1;
			});

			const emptyState = document.getElementById('emptyState');
			if (emptyState) {
				emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
			}

			const emptyText = document.getElementById('emptyStateText');
			if (emptyText) {
				emptyText.innerText = status === 'all'
					? 'No transactions yet.'
					: `No ${status} transactions found.`;
			}
		}
	</script>
</body>
</html>
