<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Flogs Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#050505',
              card: '#0d0d0d',
              border: '#18181b',
              amber: '#d97706',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #050505;
      color: #e4e4e7;
    }
    .dark-card {
      background-color: #0d0d0d;
      border: 1px solid #1c1c21;
    }
    .action-card {
      background-color: #0d0d0d;
      border: 1px solid #1c1c21;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .action-card:hover {
      background-color: #141417;
      border-color: #27272a;
      transform: translateY(-2px);
    }
    .glass-nav {
      background: rgba(13, 13, 13, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      /* Native app safe-area padding for mobile home indicators */
      padding-bottom: env(safe-area-inset-bottom, 8px);
    }
    .dashboard-loader {
      transition: opacity 300ms ease, visibility 300ms ease;
    }
    .dashboard-loader.is-hidden {
      opacity: 0;
      visibility: hidden;
    }
    .loader-icon {
      animation: loader-pulse 1.2s ease-in-out infinite;
    }
    .success-toast {
      animation: toast-in 450ms ease-out both;
    }
    @keyframes toast-in {
      from { opacity: 0; transform: translateY(-12px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes loader-pulse {
      0%, 100% { transform: scale(1); opacity: 0.65; }
      50% { transform: scale(1.08); opacity: 1; }
    }
  </style>
</head>
<body class="min-h-screen bg-brand-black text-gray-200 font-sans antialiased pb-28">

  <div id="dashboardLoader" class="dashboard-loader fixed inset-0 z-[100] flex items-center justify-center bg-black" role="status" aria-label="Loading">
    <div class="loader-icon w-16 h-16 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
      <svg class="w-9 h-9 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
      </svg>
    </div>
  </div>

  <%- include('partials/header') %>

  <% if (registrationSuccess) { %>
    <div id="registrationSuccess" class="success-toast fixed top-20 left-4 right-4 z-[80] mx-auto max-w-md" role="status" aria-live="polite">
      <div class="flex items-start gap-3 rounded-2xl border border-emerald-400/25 bg-emerald-950/90 px-4 py-3 shadow-2xl shadow-black/40 backdrop-blur-md">
        <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-emerald-400/25 bg-emerald-400/10">
          <svg class="h-4 w-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-emerald-100">Account created successfully</p>
          <p class="mt-0.5 text-xs leading-relaxed text-emerald-200/70">Your Flogs workspace is ready to go.</p>
        </div>
        <button type="button" aria-label="Dismiss notification" onclick="dismissRegistrationSuccess()" class="text-lg leading-none text-emerald-200/60 transition hover:text-emerald-100">&times;</button>
      </div>
    </div>
  <% } %>

  <main class="px-4 py-6 max-w-md mx-auto space-y-6">

    <!-- Greeting Section -->
    <div class="px-1 space-y-1">
      <h1 class="text-2xl font-bold tracking-tight text-white">Good evening, <%= user.name %></h1>
      <p class="text-sm text-zinc-400 leading-relaxed">
        Create, configure, renew, and monitor your links — all in one place.
      </p>
    </div>

    <!-- Telegram Warning Banner -->
    <div class="dark-card rounded-2xl p-4 border-amber-900/40 bg-amber-950/10 <%= user.integrations.telegram.enabled ? 'hidden' : '' %>">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-amber-400 text-sm">Telegram Chat ID Required</h3>
            <p class="text-xs text-zinc-400 mt-1 leading-normal">
              Set your Telegram Chat ID to receive notifications and logs
            </p>
          </div>
        </div>
        <button id="openTelegramModal" type="button" class="flex items-center gap-1 text-xs font-semibold text-amber-400 hover:text-amber-300 transition whitespace-nowrap pt-0.5">
          Set Up <span>&rarr;</span>
        </button>
      </div>
    </div>

    <!-- Token Balance Card -->
    <div class="dark-card rounded-2xl p-5 relative overflow-hidden">
      <div class="absolute -right-3 -bottom-3 opacity-10 pointer-events-none">
        <svg class="w-28 h-28 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium text-zinc-400">Token Balance</p>
          <p class="text-3xl font-extrabold text-white mt-0.5"><%= user.credits.balance.toLocaleString('en-NG') %></p>
        </div>
      </div>
    </div>

    <!-- Total Links Card -->
    <div class="dark-card rounded-2xl p-5 relative overflow-hidden">
      <div class="absolute -right-3 -bottom-3 opacity-10 pointer-events-none">
        <svg class="w-28 h-28 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
        </svg>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium text-zinc-400">Total Links</p>
          <p class="text-3xl font-extrabold text-white mt-0.5"><%= totalLinks %></p>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="pt-2">
      <h2 class="text-lg font-bold text-white mb-4 px-1">Quick Actions</h2>
      
      <div class="grid grid-cols-2 gap-3.5">
        
        <!-- Generate Link -->
        <a href="/dashboard/genrate" class="action-card rounded-2xl p-6 flex flex-col items-center justify-center gap-3 text-center">
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-zinc-200">Generate Link</span>
        </a>

        <!-- My Links -->
        <a href="/dashboard/links" class="action-card rounded-2xl p-6 flex flex-col items-center justify-center gap-3 text-center">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-zinc-200">My Links</span>
        </a>

        <!-- Buy Credit -->
        <a href="/dashboard/credit" class="action-card rounded-2xl p-6 flex flex-col items-center justify-center gap-3 text-center">
          <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-zinc-200">Buy Credit</span>
        </a>

        <!-- Transactions -->
        <a href="/dashboard/transactions" class="action-card rounded-2xl p-6 flex flex-col items-center justify-center gap-3 text-center">
          <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-zinc-200">Transactions</span>
        </a>

        <!-- Settings -->
        <a href="/dashboard/settings" class="action-card rounded-2xl p-6 flex flex-col items-center justify-center gap-3 text-center">
          <div class="w-12 h-12 rounded-xl bg-zinc-800/80 border border-zinc-700/50 flex items-center justify-center">
            <svg class="w-6 h-6 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-zinc-200">Settings</span>
        </a>

        <!-- SMS Verify -->
        <a href="/dashboard/sms-verify" class="action-card rounded-2xl p-6 flex flex-col items-center justify-center gap-3 text-center">
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-zinc-200">SMS Verify</span>
        </a>

      </div>
    </div>

  </main>

  <!-- Telegram Chat ID Setup Modal -->
  <div id="telegramModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center px-5 py-6" role="dialog" aria-modal="true" aria-labelledby="telegramModalTitle">
    <div id="closeTelegramBackdrop" class="absolute inset-0 bg-black/85 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-md bg-black dark-card rounded-2xl p-5 shadow-2xl shadow-black/60">
      <div class="mb-6">
        <button id="closeTelegramModal" type="button" aria-label="Go back" class="inline-flex items-center gap-2 text-zinc-400 hover:text-white text-base font-medium transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back
        </button>
      </div>
      <div id="telegramBotStep">
        <div class="space-y-1 mb-6">
          <p class="text-xs font-mono uppercase tracking-widest text-blue-400">Step 1 of 2</p>
          <h2 id="telegramModalTitle" class="text-3xl font-bold tracking-tight text-white">Find your Chat ID</h2>
          <p class="text-sm text-zinc-400 leading-relaxed">Open the Telegram bot below and send it any message. It will reply with your Chat ID.</p>
        </div>
        <a href="https://t.me/userinfobot" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between dark-card rounded-2xl p-4 hover:border-blue-500/40 transition">
          <div>
            <p class="text-xs text-zinc-500 uppercase tracking-wider">Telegram bot</p>
            <p class="text-base font-bold text-white mt-1">@userinfobot</p>
          </div>
          <span class="text-blue-400 text-sm font-semibold">Open &rarr;</span>
        </a>
        <button id="telegramNextStep" type="button" class="w-full mt-5 py-3 rounded-xl bg-white text-zinc-950 font-bold text-sm hover:bg-zinc-100 transition-colors">Next</button>
      </div>

      <form id="telegramIdStep" class="hidden space-y-4" action="/dashboard" method="post">
        <div class="space-y-1 mb-6">
          <p class="text-xs font-mono uppercase tracking-widest text-blue-400">Step 2 of 2</p>
          <h2 class="text-3xl font-bold tracking-tight text-white">Enter your Chat ID</h2>
          <p class="text-sm text-zinc-400 leading-relaxed">Paste the ID returned by @userinfobot to finish setup.</p>
        </div>
        <div>
          <label for="chatId" class="block text-xs font-mono text-zinc-400 mb-2">TELEGRAM CHAT ID</label>
          <input id="chatId" name="chatId" type="text" required placeholder="e.g. 123456789" class="w-full bg-black border border-zinc-800 focus:border-blue-500/60 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 outline-none transition-all">
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-white text-zinc-950 font-bold text-sm hover:bg-zinc-100 transition-colors">Save Chat ID</button>
      </form>
    </div>
  </div>

  <%- include('partials/nav', { activeNav: activeNav }) %>

  <script>
    window.addEventListener('load', () => {
      window.setTimeout(() => {
        document.getElementById('dashboardLoader').classList.add('is-hidden');
      }, 350);

      window.setTimeout(dismissRegistrationSuccess, 5000);
    });

    function dismissRegistrationSuccess() {
      const notification = document.getElementById('registrationSuccess');
      if (notification) notification.remove();
    }

    const telegramModal = document.getElementById('telegramModal');
    const openTelegramModal = document.getElementById('openTelegramModal');
    const closeTelegramModal = document.getElementById('closeTelegramModal');
    const closeTelegramBackdrop = document.getElementById('closeTelegramBackdrop');
    const telegramBotStep = document.getElementById('telegramBotStep');
    const telegramIdStep = document.getElementById('telegramIdStep');
    const telegramNextStep = document.getElementById('telegramNextStep');

    function closeModal() {
      telegramModal.classList.add('hidden');
    }

    function showTelegramBotStep() {
      telegramBotStep.classList.remove('hidden');
      telegramIdStep.classList.add('hidden');
    }

    openTelegramModal.addEventListener('click', () => {
      telegramModal.classList.remove('hidden');
      showTelegramBotStep();
    });
    telegramNextStep.addEventListener('click', () => {
      telegramBotStep.classList.add('hidden');
      telegramIdStep.classList.remove('hidden');
      document.getElementById('chatId').focus();
    });
    closeTelegramModal.addEventListener('click', closeModal);
    closeTelegramBackdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeModal();
    });
  </script>

</body>
</html>
