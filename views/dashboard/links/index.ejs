<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
	<title><%= pageTitle || 'Flogs — My Links' %></title>
	<script src="https://cdn.tailwindcss.com"></script>
	<script>
		tailwind.config = {
			theme: {
				extend: {
					colors: {
						brand: {
							black: '#050505',
							card: '#0d0d0d',
							border: '#18181b',
							amber: '#d97706',
						}
					}
				}
			}
		}
	</script>
	<style>
		body { background-color: #050505; color: #e4e4e7; }
		.dark-card { background-color: #0d0d0d; border: 1px solid #1c1c21; }
		.glass-nav {
			background: rgba(13, 13, 13, 0.85);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border-top: 1px solid rgba(255, 255, 255, 0.08);
			padding-bottom: env(safe-area-inset-bottom, 8px);
		}
	</style>
</head>
<body class="min-h-screen bg-brand-black text-gray-200 font-sans antialiased pb-28">

	<%- include('../partials/header') %>

	<main class="px-4 py-6 max-w-md mx-auto space-y-6">
		<div class="px-1 space-y-1">
			<h1 class="text-2xl font-bold tracking-tight text-white">My Links</h1>
			<p class="text-sm text-zinc-400 leading-relaxed">Manage and monitor all your campaign links.</p>
		</div>

		<div class="dark-card rounded-2xl p-8 text-center">
			<div class="w-14 h-14 mx-auto rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
				<svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
				</svg>
			</div>
			<h2 class="mt-5 text-lg font-bold text-white">No links yet</h2>
			<p class="mt-2 text-sm text-zinc-400 leading-relaxed">Create your first campaign link to start tracking performance.</p>
			<a href="/dashboard/genrate" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-zinc-950 hover:bg-zinc-100 transition">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
				</svg>
				Create New Link
			</a>
		</div>
	</main>

	<%- include('../partials/nav', { activeNav: activeNav }) %>

</body>
</html>
